# MCD — environment variables
#
# Copy this file to .env and fill in the values.
# The .env file is gitignored — never commit real credentials.
# Each variable is read with os.environ.get() in the code that needs it.

# ── AWS credentials (required for Bedrock models and the LLM judge) ──────────
#
# Get these from AWS IAM → Users → your user → Security credentials → Create access key.
# boto3 also accepts AWS_SESSION_TOKEN when you use temporary credentials.
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# ── Bedrock client tuning (optional — these are the defaults) ─────────────────
#
# BEDROCK_MAX_RETRIES   how many times to retry a throttled call before giving up
# BEDROCK_TIMEOUT       not used yet; reserved for socket-level timeout tuning
#
BEDROCK_MAX_RETRIES=5
BEDROCK_TIMEOUT=60

# ── Sol / vLLM (set by Harpreet, here for reference) ─────────────────────────
#
# HF_TOKEN   your Hugging Face token for gated models (Llama family)
#            Set in your terminal before running sbatch: export HF_TOKEN=hf_...
#
HF_TOKEN=
