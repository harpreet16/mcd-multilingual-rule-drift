# Secrets: never commit keys or tokens
.env
*.key
*token*.txt

# Run outputs: only the final replies (runs/<model>/responses.jsonl) are committed, so the grader can use them.
runs/*/*
!runs/*/responses.jsonl
outputs/
pilots/out/
*.log

# Python and editor files
__pycache__/
*.pyc
.venv/
.DS_Store

# Claude Code files stay local
CLAUDE.md
.claude/

# Intermediate files of the dataset build (see dataset/README.md)
draft.jsonl

# Editor and test caches
.vscode/
.idea/
.pytest_cache/
